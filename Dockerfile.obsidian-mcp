FROM debian:trixie-slim

ARG OBSIDIAN_MCP_VERSION=3.1.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
        -o /tmp/obsidian-mcp.tar.gz \
        "https://github.com/lstpsche/obsidian-mcp/releases/download/v${OBSIDIAN_MCP_VERSION}/obsidian-mcp-${OBSIDIAN_MCP_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/obsidian-mcp.tar.gz -C /usr/local/bin obsidian-mcp \
    && rm -f /tmp/obsidian-mcp.tar.gz \
    && chmod +x /usr/local/bin/obsidian-mcp

# Semantic search daemon downloads itself on first run; keep its state inside a volume.
VOLUME ["/root/.local"]

EXPOSE 37842

# The vault's parent is mounted at /vaults so the real vault directory name is
# preserved in the path. resolve-vault.sh discovers the single child vault at
# startup rather than hardcoding a name, and mirrors
# second_brain.resolve_vault_root() so both services always agree on the vault.
ENV VAULT_PARENT=/vaults
COPY resolve-vault.sh /usr/local/bin/resolve-vault.sh
RUN chmod +x /usr/local/bin/resolve-vault.sh

CMD ["/usr/local/bin/resolve-vault.sh"]