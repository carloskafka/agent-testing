# === Model Provider ===
# Set to "gemini" or "openrouter"
MODEL_PROVIDER=gemini

# === Gemini (free tier) ===
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === OpenRouter (free models with :free suffix) ===
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional: pick a specific free model alias (gemma, qwen, nvidia)
# If empty, defaults to google/gemma-4-26b-a4b-it:free
MODEL_ALIAS=gemma

# === Langfuse (optional observability) ===
# Self-host: docker compose --env-file langfuse.env up -d  (in text_summarizer/)
LANGFUSE_PUBLIC_KEY=pk-lf-your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_langfuse_secret_key_here
LANGFUSE_BASE_URL=http://localhost:3000
# Prompt name reported on every generation span; Langfuse stores it as
# `prompt_name`, which is the dimension the dashboards break usage down by.
LANGFUSE_PROMPT_NAME=text_summarizer
# Trace name reported on every run (defaults to "text_summarizer").
LANGFUSE_TRACE_NAME=
# Seconds to wait for the (blocking, discouraged) auth check before instrumenting
# anyway. Prevents a slow Langfuse from silently disabling all tracing.
LANGFUSE_AUTH_CHECK_TIMEOUT=5

# === Obsidian MCP (optional) — set exactly one ===
OBSIDIAN_VAULT_PATH=/absolute/path/to/vault
OBSIDIAN_MCP_URL=http://127.0.0.1:37842/mcp

# === Gmail (optional, read-only) ===
# The agent can read your inbox once all three are set. Client id/secret come
# from a Desktop-app OAuth client in the Google Cloud Console; the refresh token
# is minted once with:
#   uv run python -m text_summarizer.gmail_oauth --client-secret-file client_secret.json --console
# (Omit --client-secret-file if GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET already
# exist in this .env.) --console prints a URL to open in any browser and accepts
# the authorization code on the terminal -- needed when the browser can't reach
# localhost (e.g. inside a VM). See docs/INTEGRATIONS.md for the full flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# === Second Brain vault (optional) ===
# Absolute path where summaries/chat logs are written (defaults to /vault in docker).
# Point this at the vault's PARENT directory when the vault is bind-mounted: the
# code picks one vault out of that directory (see vaults.py), so the real vault name
# survives in the path instead of being flattened to the mount point.
SECOND_BRAIN_VAULT=/absolute/path/to/your/vault

# === Choosing a vault when you have several (optional) ===
# obsidian-mcp serves exactly ONE vault, so when the parent above holds more than
# one, the choice has to be explicit -- it is never guessed. Resolution order:
#   1. OBSIDIAN_VAULT_NAME, if set  -> that vault, whatever else is in the parent
#   2. the parent is itself a vault -> used as-is
#   3. exactly one child             -> used, no configuration needed
#   4. no children                   -> "agent-vault" is auto-created
#   5. several children, no name     -> refuses, and lists the candidates by name
# ./run.sh turns the same discovery into a numbered menu (including the vaults
# Obsidian already knows about) and writes your answer back to this file.
OBSIDIAN_VAULT_NAME=

# === Vault identity (optional) ===
# Usually NOT needed. This is a LABEL for the resolved vault, rendered in every
# **Sources** line, e.g.
#   [obsidian][ck][gemini-3.5-flash-lite][[Note Title]]: reason
# It does NOT choose the vault -- that is OBSIDIAN_VAULT_NAME above.
# Resolution order at runtime (see AGENTS.md, "Vault name resolution"):
#   1. basename(SECOND_BRAIN_VAULT), after resolve_vault_root() picks a vault out of
#      the parent -- correct for free, locally and under Docker
#   2. VAULT_NAME          <- this value, only if the vault is mounted directly
#   3. obsidian-mcp vault_info tool result, if a turn called it
#   4. "unknown"
# Set this ONLY when step 1 cannot work, i.e. the vault itself (not its parent) is
# bind-mounted, which hides the host directory name.
VAULT_NAME=

# === Cache & eval (optional) ===
# "false" bypasses the vault cache (traces tagged cache-disabled). Keep it OFF
# for `adk eval` so runs always hit the real agent and the vault tools.
CACHE_ENABLED=true

# === Docker only (optional) ===
# Used by docker-compose.yml / resolve-vault.sh, not by the Python code.
# OBSIDIAN_VAULT_PARENT_HOST: host path to the directory that holds the vault(s).
# Compose bind-mounts it at /vaults. Empty/missing -> the vault is auto-created
# there as "agent-vault" on first boot (default: ./vaults). Holding several
# vaults is fine: set OBSIDIAN_VAULT_NAME to choose one.
OBSIDIAN_VAULT_PARENT_HOST=./vaults
# VAULT_PARENT: in-container mount point that holds the vault (default /vaults).
VAULT_PARENT=/vaults
# OBSIDIAN_MCP_PORT: HTTP listen port for the obsidian-mcp server.
OBSIDIAN_MCP_PORT=37842
