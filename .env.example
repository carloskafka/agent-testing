# === Model Provider ===
# Set to "gemini" or "openrouter"
# Which chain to build. NOTE: the default `gemini` no longer means "Gemini first" --
# since 2026-10-03 that branch is ordered OpenCode -> free OpenRouter -> Gemini, so
# Gemini is the always-present floor rather than the default. Use `openrouter` for an
# OpenRouter-led chain, which contains no Gemini at all.
MODEL_PROVIDER=gemini

# === Gemini (free tier) ===
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === OpenRouter (free models with :free suffix) ===
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional: pick a specific free model alias (lfm, ling, dots, gemma, qwen, nvidia)
# Defaults to the fastest measured: lfm (liquid/lfm-2.5-2.6b, median 0.45s on 2026-10-02).
MODEL_ALIAS=lfm

# === Langfuse (optional observability) ===
# Self-host: docker compose --env-file langfuse.env up -d  (in text_summarizer/)
LANGFUSE_PUBLIC_KEY=pk-lf-your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_langfuse_secret_key_here
LANGFUSE_BASE_URL=http://localhost:3000
# Prompt name reported on every generation span; Langfuse stores it as
# `prompt_name`, which is the dimension the dashboards break usage down by.
LANGFUSE_PROMPT_NAME=text_summarizer
# Trace name reported on every run (defaults to "text_summarizer").
LANGFUSE_TRACE_NAME=
# Seconds to wait for the (blocking, discouraged) auth check before instrumenting
# anyway. Prevents a slow Langfuse from silently disabling all tracing.
LANGFUSE_AUTH_CHECK_TIMEOUT=5

# === Obsidian MCP (optional) — set exactly one ===
OBSIDIAN_VAULT_PATH=/absolute/path/to/vault
OBSIDIAN_MCP_URL=http://127.0.0.1:37842/mcp

# === Gmail (optional, read-only) ===
# The agent can read your inbox once all three are set. Client id/secret come
# from a Desktop-app OAuth client in the Google Cloud Console; the refresh token
# is minted once with:
#   uv run python -m text_summarizer.gmail_oauth --client-secret-file client_secret.json --console
# (Omit --client-secret-file if GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET already
# exist in this .env.) --console prints a URL to open in any browser and accepts
# the authorization code on the terminal -- needed when the browser can't reach
# localhost (e.g. inside a VM). See docs/INTEGRATIONS.md for the full flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# === Web search (optional) — SearXNG ===
# The third retrieval tier: vault -> web -> the model's own knowledge. Two tools,
# web_search and web_fetch, appear only when SEARXNG_URL is set. Blank means no web
# tools and the agent behaves exactly as before.
#
# SearXNG runs as a SEPARATE compose project, not in this repository. Bring it up
# first with `docker compose up -d` in its own directory, then set the URL below.
# Under docker-compose.yml the agent reaches it over a shared external network as
# http://searxng:8080 -- a service name, not a published port, so nothing is exposed
# on the LAN for the agent's sake. run.sh creates that network when SEARXNG_URL is
# set; the SearXNG project must join it too.
# The host must be the SERVICE NAME of your SearXNG container on agent-net, which
# is whatever your SearXNG compose project calls it — check with
# `docker network inspect agent-net`. This repo's own SearXNG is `searxng-core`.
# A wrong name does not error loudly: web_search returns failures as *data* so the
# model can fall through, so the tier silently stops being a tier and the agent
# answers from its own training data while the tools look present.
SEARXNG_URL=http://searxng-core:8080

# Set false to remove the web tools while leaving SEARXNG_URL in place. Eval runs
# do exactly this: live search results change daily, so allowing them would make
# response_match_score measure the day rather than the instruction edit. Same
# reasoning as CACHE_ENABLED.
WEB_SEARCH_ENABLED=true

# === Weather (optional) — Open-Meteo ===
# A dedicated tier for one question class: the weather of a named place. One tool,
# weather_forecast, answering max/min temperature, apparent temperature, humidity,
# rain chance, precipitation, wind and gusts, UV, sunshine, sunrise/sunset, radiation
# and evapotranspiration for 1–14 days.
#
# Enabled by DEFAULT. `false` removes the tool, which is the opt-out rather than the
# opt-in: a deployment that has never heard of this tier has no way to configure it
# and would otherwise keep answering the weather from a training cutoff.
WEATHER_ENABLED=true
#
# Open-Meteo is free and keyless, which is the whole reason for it — it is the only
# no-key provider publishing all of the above. Both endpoints are overridable for a
# mirror or a self-hosted instance, and both are treated as OPERATOR-CONFIGURED for
# the SSRF check: a self-hosted weather API is on a Docker bridge, exactly like
# SearXNG above, so it is dialled with allow_private. Link-local stays refused.
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
#
# Rendered in slot two of every [web] line this tier produces, i.e. what the source
# line says the reading came from. Never the vault, never the search engine.
WEATHER_PROVIDER=open-meteo
#
# Language of the gazetteer's own place names. Measured, not assumed: with `pt`,
# "Londres" resolves to London (8.96M) instead of a 2,627-person village in
# Catamarca. It does NOT fix every name — "Nova York" is *Nova Iorque, Maranhão*
# (4,320 people) in every language, and "New York" is *York, Nebraska* — so the
# resolved city, state, country and population are reported in the payload and the
# model is instructed to check them rather than to trust the geocoder.
WEATHER_LANGUAGE=pt

# === Headless-browser renderer (optional) ===
# web_fetch tries a plain HTTP GET first and only falls back to a real browser when
# what came back is too thin to be the page -- which is what a JavaScript-built page
# looks like. Measured: ingresso.com/filmes is 94,700 bytes of HTML that reduce to
# 183 characters of visible text; the same URL through Chromium yields 2,024 naming
# the actual films, in 2.1s.
#
# The renderer is also a SEPARATE compose project, for the same reason SearXNG is and
# for a sharper one: this container executes JavaScript written by whoever published
# the page, so it holds no vault mount, no API key and no published port. It lives
# outside this repository, at ~/Downloads/apps/chromium.
#
# Blank means the fallback is never taken and a thin page is returned as-is rather
# than failed -- an unconfigured deployment is byte-for-byte unchanged. Read the host
# off `docker network inspect agent-net`, not out of a document: it must be your
# renderer's SERVICE NAME on that bridge, or the name does not resolve. Every failure
# here is returned to the model as data, so a wrong host degrades the tier silently
# rather than loudly, which is exactly how the documented `searxng:8080` shipped.
RENDERER_URL=http://renderer:8080

# === Age gates and dismissals ===
#
# A page behind an age or eligibility gate (an 18+ rating, a region lock) hides its
# content behind a button. `web_fetch` detects that and returns a refusal naming the
# gate; the agent then calls `ask_user`, and only if YOU actually answer may it call
# `web_fetch(attested=true)`. That flag is checked, not trusted: an attestation with
# no recorded answer behind it is refused, because attesting is your statement and
# not the model's.
#
# These two lists live in the RENDERER's environment, not the agent's -- they decide
# what the renderer is allowed to click, and the renderer is the process that runs a
# stranger's JavaScript. Both blank means the dismiss primitive is OFF, which is the
# right state until you mean it.
#
#   RENDERER_DISMISS_HOSTS=ingresso.com
#   RENDERER_DISMISS_TEXT=I'm aware,I agree,I accept,Accept all,Got it,Continue,Allow all
#
# `HOSTS` is a suffix match on the registrable name, so `ingresso.com` also covers
# `checkout.ingresso.com`. `TEXT` is matched against a button's whole label, and
# should be kept to *acknowledgements* -- things that clear a layer already on screen.
#
# What stops a purchase regardless of what you put in TEXT: the renderer refuses any
# element inside a `<form>`, and reports a click that navigated the page as an error.
# No list of phrases can reach a checkout, because clearing an overlay is not allowed
# to advance the page.

# === Second Brain vault (optional) ===
# Absolute path where summaries/chat logs are written (defaults to /vault in docker).
# Point this at the vault's PARENT directory when the vault is bind-mounted: the
# code picks one vault out of that directory (see vaults.py), so the real vault name
# survives in the path instead of being flattened to the mount point.
SECOND_BRAIN_VAULT=/absolute/path/to/your/vault

# === Choosing a vault when you have several (optional) ===
# obsidian-mcp serves exactly ONE vault, so when the parent above holds more than
# one, the choice has to be explicit -- it is never guessed. Resolution order:
#   1. OBSIDIAN_VAULT_NAME, if set  -> that vault, whatever else is in the parent
#   2. the parent is itself a vault -> used as-is
#   3. exactly one child             -> used, no configuration needed
#   4. no children                   -> "agent-vault" is auto-created
#   5. several children, no name     -> refuses, and lists the candidates by name
# ./run.sh turns the same discovery into a numbered menu (including the vaults
# Obsidian already knows about) and writes your answer back to this file.
OBSIDIAN_VAULT_NAME=

# === Vault identity (optional) ===
# Usually NOT needed. This is a LABEL for the resolved vault, rendered in every
# **Sources** line, e.g.
#   [obsidian][ck][gemini-3.5-flash-lite][[Note Title]]: reason
# It does NOT choose the vault -- that is OBSIDIAN_VAULT_NAME above.
# Resolution order at runtime (see AGENTS.md, "Vault name resolution"):
#   1. basename(SECOND_BRAIN_VAULT), after resolve_vault_root() picks a vault out of
#      the parent -- correct for free, locally and under Docker
#   2. VAULT_NAME          <- this value, only if the vault is mounted directly
#   3. obsidian-mcp vault_info tool result, if a turn called it
#   4. "unknown"
# Set this ONLY when step 1 cannot work, i.e. the vault itself (not its parent) is
# bind-mounted, which hides the host directory name.
VAULT_NAME=

# === Cache & eval (optional) ===
# "false" bypasses the vault cache (traces tagged cache-disabled). Keep it OFF
# for `adk eval` so runs always hit the real agent and the vault tools.
CACHE_ENABLED=true

# === Answer presentation (optional) ===
# The name stamped in bold at the head of every answer. Leave this UNSET (i.e.
# keep the line commented out) and the label is derived from the agent's own
# name, so `text_summarizer` is presented as "Text Summarizer Agent" and
# renaming the agent renames the label too. Uncomment to pin a product name, or
# to set it EMPTY to turn the stamp off -- the control to run against when you
# want to measure what it changes. Note the asymmetry: commented out derives the
# label, `BOT_NAME=` (present but empty) disables the stamp.
# Stamped in code after the model runs: no output tokens, and it never reaches
# the notes in the vault.
# BOT_NAME=

# === Docker only (optional) ===
# Used by docker-compose.yml / resolve-vault.sh, not by the Python code.
# OBSIDIAN_VAULT_PARENT_HOST: host path to the directory that holds the vault(s).
# Compose bind-mounts it at /vaults. Empty/missing -> the vault is auto-created
# there as "agent-vault" on first boot (default: ./vaults). Holding several
# vaults is fine: set OBSIDIAN_VAULT_NAME to choose one.
OBSIDIAN_VAULT_PARENT_HOST=./vaults
# VAULT_PARENT: in-container mount point that holds the vault (default /vaults).
VAULT_PARENT=/vaults
# OBSIDIAN_MCP_PORT: HTTP listen port for the obsidian-mcp server.
OBSIDIAN_MCP_PORT=37842
